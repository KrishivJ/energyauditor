# Copy to .env.local for local dev (Vite reads VITE_*-prefixed vars).
# These are PUBLIC values — safe to expose in the browser bundle.

# Supabase project URL and anon (publishable) key — Settings → API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Backend base URL. Leave EMPTY in dev so requests use the Vite proxy (/api →
# localhost:8000). In production set it to the deployed backend, e.g.
# https://building-energy-lens.onrender.com
VITE_API_BASE=
